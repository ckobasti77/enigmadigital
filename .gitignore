env.personal.txt

# service account kljucevi i ostale tajne — NIKAD u git
enigma-command-center-*.json
client_secret_*.json
*service-account*.json
enigmaitapitooldesign.pdf

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# lokalni noćni run + git lock smeće
overnight/
_to_delete/
# izlaz noćnih prolaza (logs/<modul>/<ID>.log) — lokalni artefakt, može da
# sadrži isečke odgovora providera
logs/

# threads probe token i privremeni oauth podaci
.threads-probe-token
.threads-probe-token.meta.json
.threads-oauth-state


# 100 skilova (~5 MB) - lokalni alati, ne kod projekta
