# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# licne referentne vrednosti i tajne (i pre preimenovanja u .env.personal)
env.personal.txt

# service account kljucevi i ostale tajne — NIKAD u git
enigma-command-center-*.json
client_secret_*.json
*service-account*.json
enigmaitapitooldesign.pdf

# maplibre worker (generisan iz node_modules kroz scripts/copy-maplibre-worker.mjs;
# verzija prati package-lock, ne git) — GL6 §1
/public/maplibre/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# lokalni noćni run + git lock smeće
overnight/
_to_delete/
# izlaz noćnih prolaza (logs/<modul>/<ID>.log) — lokalni artefakt, može da
# sadrži isečke odgovora providera
logs/

# threads probe token i privremeni oauth podaci
.threads-probe-token
.threads-probe-token.meta.json
.threads-oauth-state


# 100 skilova (~5 MB) - lokalni alati, ne kod projekta
.claude/skills/

# B-faze UI boosta: lokalni snimci (~4 MB po fazi); A-snimci ostaju u repou
nocni-run/ux/b*

# nocni run projekti (logovi i stanje runnera)
.nocni-run/projekti/logs/
.nocni-run/projekti/tmp/
.nocni-run/projekti/state.json
.nocni-run/projekti/state.json.tmp
.nocni-run/projekti/state.bad.json
.nocni-run/projekti/STOP
.nocni-run/projekti/baseline.txt
.nocni-run/projekti/mcp.json

# nocni run ultra1 (logovi i stanje runnera)
.nocni-run/ultra1/logs/
.nocni-run/ultra1/tmp/
.nocni-run/ultra1/state.json
.nocni-run/ultra1/state.json.tmp
.nocni-run/ultra1/state.bad.json
.nocni-run/ultra1/STOP
.nocni-run/ultra1/baseline.txt
.nocni-run/ultra1/mcp.json

# nocni run spajanje (logovi, stanje runnera i snimak Devotiona)
.nocni-run/spajanje/logs/
.nocni-run/spajanje/tmp/
.nocni-run/spajanje/state.json
.nocni-run/spajanje/state.json.tmp
.nocni-run/spajanje/state.bad.json
.nocni-run/spajanje/STOP
.nocni-run/spajanje/baseline.txt
.nocni-run/spajanje/mcp.json
